# 不依赖API时明确显示extractive摘录模式；真实生成改deepseek。
TRACERAG_PROVIDER=extractive
TRACERAG_RETRIEVAL=hybrid
TRACERAG_TRANSLATOR=qwen
TRACERAG_EMBEDDING=minilm
TRACERAG_RERANKER=none
TRACERAG_DEVICE=auto
TRACERAG_DATA_DIR=data/runtime
TRACERAG_CHUNK_CHARS=800
TRACERAG_OVERLAP_CHARS=120
TRACERAG_CANDIDATE_K=20
TRACERAG_MAX_UPLOAD_BYTES=10485760
TRACERAG_MAX_CONTEXT_CHARS=16000
TRACERAG_OCR_ENABLED=true
TRACERAG_OCR_MAX_PAGES=30
TRACERAG_OCR_MAX_IMAGE_PIXELS=20000000
TRACERAG_OCR_MIN_CONFIDENCE=0.5
TRACERAG_TIMEOUT_SECONDS=60
TRACERAG_API_RETRIES=2

# DeepSeek 真实调用。复制为 .env 后再填写，不要提交 .env。
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
